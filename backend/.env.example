# Leave DATABASE_URL empty to use the local SQLite file (backend/dengue.db).
# For Supabase use the "Transaction pooler" connection string (port 6543).
DATABASE_URL=
# Long random text used to sign login tokens (needed from the login step onward).
JWT_SECRET=
# Secret code that allows registering an admin account (needed from the login step onward).
ADMIN_SIGNUP_CODE=
