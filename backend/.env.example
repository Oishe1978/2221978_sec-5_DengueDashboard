# Leave DATABASE_URL empty to use the local SQLite file (backend/dengue.db).
# For Supabase use the "Transaction pooler" connection string (port 6543).
DATABASE_URL=

# Secrets: long random text, different for each one. Never commit real values.
JWT_SECRET=
PASSWORD_PEPPER=
ADMIN_SIGNUP_CODE=

# Optional overrides (defaults shown)
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
# MAX_FAILED_LOGINS=5
# LOCK_MINUTES=15
